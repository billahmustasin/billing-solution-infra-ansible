# {{ kafka_config_dir }}/server.properties — managed by Ansible
# {{ ansible_managed }}
# KRaft mode — no ZooKeeper

process.roles={{ kafka_process_roles }}
node.id={{ kafka_broker_id }}

controller.quorum.voters={{ kafka_controller_quorum_voters }}

{% if kafka_role == 'controller' %}
listeners=CONTROLLER://0.0.0.0:{{ kafka_controller_port }}
listener.security.protocol.map=CONTROLLER:PLAINTEXT
controller.listener.names=CONTROLLER
{% else %}
listeners=PLAINTEXT://0.0.0.0:{{ kafka_port }},CONTROLLER://0.0.0.0:{{ kafka_controller_port }}
advertised.listeners=PLAINTEXT://{{ ansible_default_ipv4.address }}:{{ kafka_port }}
listener.security.protocol.map=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
inter.broker.listener.name=PLAINTEXT
controller.listener.names=CONTROLLER
{% endif %}

log.dirs={{ kafka_log_dir }}/data
num.network.threads=3
num.io.threads=8
socket.send.buffer.bytes=102400
socket.receive.buffer.bytes=102400
socket.request.max.bytes=104857600

{% if kafka_role != 'controller' %}
num.partitions={{ kafka_num_partitions }}
default.replication.factor={{ kafka_default_replication_factor }}
min.insync.replicas={{ kafka_min_insync_replicas }}
offsets.topic.replication.factor={{ kafka_default_replication_factor }}
transaction.state.log.replication.factor={{ kafka_default_replication_factor }}
transaction.state.log.min.isr={{ kafka_min_insync_replicas }}

log.retention.hours={{ kafka_log_retention_hours }}
log.segment.bytes=1073741824
log.retention.check.interval.ms=300000
group.initial.rebalance.delay.ms=0
auto.create.topics.enable=true
delete.topic.enable=true
{% endif %}
