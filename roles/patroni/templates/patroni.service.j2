# roles/patroni/templates/patroni.service.j2
[Unit]
Description=Patroni PostgreSQL HA
After=network.target etcd.service

[Service]
User=postgres
Group=postgres
ExecStart=/opt/patroni/bin/patroni /etc/patroni/patroni.yml
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=120
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
