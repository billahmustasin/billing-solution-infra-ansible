[Unit]
Description=Redis In-Memory Data Store
Documentation=https://redis.io/documentation
After=network.target

[Service]
Type=notify
User={{ kv_user }}
Group={{ kv_group }}
ExecStart={{ kv_server_bin }} {{ kv_config_dir }}/{{ kv_server_conf }} --supervised systemd
ExecStop={{ kv_cli_bin }} shutdown
Restart=on-failure
RestartSec=5
RuntimeDirectory={{ kv_user }}
RuntimeDirectoryMode=0755
LimitNOFILE=10032
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ kv_log_dir }} {{ kv_data_dir }} {{ kv_run_dir }}

[Install]
WantedBy=multi-user.target
