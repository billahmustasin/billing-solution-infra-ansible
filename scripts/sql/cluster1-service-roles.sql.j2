-- Cluster 1 leader (db-a1a). Additive — does not drop production_db_user.
-- One LOGIN per service so PgBouncer gets a separate session pool per user.
-- Password comes from app_db_password in group_vars vault.yml.

DO $$
DECLARE
  pw text := '{{ app_db_password | replace("'", "''") }}';
  r text;
BEGIN
  FOREACH r IN ARRAY ARRAY[
    'race_billing_srv_user',
    'race_entity_srv_user',
    'race_meta_srv_user',
    'race_invoice_srv_user',
    'race_report_srv_user',
    'race_appadmin_srv_user',
    'race_billing_user',
    'race_partner_user'
  ]
  LOOP
    BEGIN
      EXECUTE format('CREATE ROLE %I LOGIN PASSWORD %L', r, pw);
    EXCEPTION
      WHEN duplicate_object THEN
        EXECUTE format('ALTER ROLE %I WITH LOGIN PASSWORD %L', r, pw);
    END;
  END LOOP;
END
$$;

GRANT CONNECT, TEMPORARY ON DATABASE race_core_service TO
  race_billing_srv_user, race_entity_srv_user, race_meta_srv_user,
  race_invoice_srv_user, race_report_srv_user, race_appadmin_srv_user;
GRANT CONNECT, TEMPORARY ON DATABASE race_billing TO race_billing_user;
GRANT CONNECT, TEMPORARY ON DATABASE race_partner TO race_partner_user;

\c race_core_service

GRANT USAGE ON SCHEMA public TO
  race_billing_srv_user, race_entity_srv_user, race_meta_srv_user,
  race_invoice_srv_user, race_report_srv_user, race_appadmin_srv_user;

GRANT USAGE, CREATE ON SCHEMA race_billing_srv TO race_billing_srv_user;
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA race_billing_srv TO race_billing_srv_user;
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA race_billing_srv TO race_billing_srv_user;
GRANT ALL PRIVILEGES ON ALL FUNCTIONS IN SCHEMA race_billing_srv TO race_billing_srv_user;
ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA race_billing_srv GRANT ALL ON TABLES TO race_billing_srv_user;
ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA race_billing_srv GRANT ALL ON SEQUENCES TO race_billing_srv_user;
ALTER DEFAULT PRIVILEGES FOR ROLE production_db_user IN SCHEMA race_billing_srv GRANT ALL ON TABLES TO race_billing_srv_user;
ALTER DEFAULT PRIVILEGES FOR ROLE production_db_user IN SCHEMA race_billing_srv GRANT ALL ON SEQUENCES TO race_billing_srv_user;
