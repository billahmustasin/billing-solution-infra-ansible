-- Cluster 2 leader. Human/ops login — not for application pods.
-- Same capability as the old production_db_user on C2 DBs/schemas.
-- NOCREATEDB / cannot CREATE or DROP databases. Not a superuser.

DO $$
BEGIN
  CREATE ROLE race_ops_user LOGIN
    NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION
    PASSWORD '{{ ops_db_password | replace("'", "''") }}';
EXCEPTION
  WHEN duplicate_object THEN
    ALTER ROLE race_ops_user WITH LOGIN
      NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION
      PASSWORD '{{ ops_db_password | replace("'", "''") }}';
END
$$;

GRANT CONNECT, TEMPORARY ON DATABASE race_core_service TO race_ops_user;
GRANT CONNECT, TEMPORARY ON DATABASE race_superapp TO race_ops_user;
GRANT CONNECT, TEMPORARY ON DATABASE race_customer_chat TO race_ops_user;
REVOKE CREATE ON DATABASE race_core_service FROM race_ops_user;
REVOKE CREATE ON DATABASE race_superapp FROM race_ops_user;
REVOKE CREATE ON DATABASE race_customer_chat FROM race_ops_user;

GRANT race_customer_srv_user, race_finance_srv_user, race_notification_srv_user,
      race_scheduler_srv_user, race_loyalty_campaign_srv_user,
      race_superapp_user, race_customer_chat_user TO race_ops_user;

\c race_core_service

GRANT USAGE ON SCHEMA public TO race_ops_user;

GRANT USAGE, CREATE ON SCHEMA race_customer_srv TO race_ops_user;
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA race_customer_srv TO race_ops_user;
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA race_customer_srv TO race_ops_user;
GRANT ALL PRIVILEGES ON ALL FUNCTIONS IN SCHEMA race_customer_srv TO race_ops_user;
ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA race_customer_srv GRANT ALL ON TABLES TO race_ops_user;
ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA race_customer_srv GRANT ALL ON SEQUENCES TO race_ops_user;
ALTER DEFAULT PRIVILEGES FOR ROLE race_customer_srv_user IN SCHEMA race_customer_srv GRANT ALL ON TABLES TO race_ops_user;
