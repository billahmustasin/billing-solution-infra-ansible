  race_scheduler_srv_user, race_loyalty_campaign_srv_user;

GRANT USAGE, CREATE ON SCHEMA race_customer_srv TO race_customer_srv_user;
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA race_customer_srv TO race_customer_srv_user;
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA race_customer_srv TO race_customer_srv_user;
GRANT ALL PRIVILEGES ON ALL FUNCTIONS IN SCHEMA race_customer_srv TO race_customer_srv_user;
ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA race_customer_srv GRANT ALL ON TABLES TO race_customer_srv_user;
ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA race_customer_srv GRANT ALL ON SEQUENCES TO race_customer_srv_user;
ALTER DEFAULT PRIVILEGES FOR ROLE production_db_user IN SCHEMA race_customer_srv GRANT ALL ON TABLES TO race_customer_srv_user;
ALTER DEFAULT PRIVILEGES FOR ROLE production_db_user IN SCHEMA race_customer_srv GRANT ALL ON SEQUENCES TO race_customer_srv_user;
