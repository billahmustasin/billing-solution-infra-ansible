-- Cluster 2 leader (db-a2a). Additive — does not drop production_db_user.
-- One LOGIN per service so PgBouncer gets a separate session pool per user.

DO $$
DECLARE
  pw text := '{{ app_db_password | replace("'", "''") }}';
  r text;
BEGIN
  FOREACH r IN ARRAY ARRAY[
    'race_customer_srv_user',
    'race_finance_srv_user',
    'race_notification_srv_user',
    'race_scheduler_srv_user',
    'race_loyalty_campaign_srv_user',
    'race_superapp_user',
    'race_customer_chat_user'
  ]
  LOOP
    BEGIN
      EXECUTE format('CREATE ROLE %I LOGIN PASSWORD %L', r, pw);
    EXCEPTION
      WHEN duplicate_object THEN
        EXECUTE format('ALTER ROLE %I WITH LOGIN PASSWORD %L', r, pw);
    END;
  END LOOP;
END
$$;

GRANT CONNECT, TEMPORARY ON DATABASE race_core_service TO
  race_customer_srv_user, race_finance_srv_user, race_notification_srv_user,
  race_scheduler_srv_user, race_loyalty_campaign_srv_user;
GRANT CONNECT, TEMPORARY ON DATABASE race_superapp TO race_superapp_user;
GRANT CONNECT, TEMPORARY ON DATABASE race_customer_chat TO race_customer_chat_user;

\c race_core_service

GRANT USAGE ON SCHEMA public TO
